{
  "name": "pi-pid1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An experimental model-driven container init",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "make && tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=15000 test/*.test.mjs",
    "test:container": "node --test --test-timeout=18000 test/container.mjs",
    "test:live": "npm run build && node --test --test-timeout=55000 test/live.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
